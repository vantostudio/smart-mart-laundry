# Environment variable names for the admin backend. Names only, never real values.
#
# On Cloudflare these are Wrangler secrets: `wrangler secret put <NAME>` for production, and
# `wrangler secret put <NAME> --env preview` for the preview Worker.
# Locally they go in `.dev.vars` for `wrangler dev` / preview, or `.env.local` for `next dev`.
# Never commit real values.
#
# The env schemas (`serverEnv()`, `authEnv()` and `storageEnv()` in `src/config/env.ts`) follow these names.

# Neon pooled connection string, used by the app (the `dev` branch for local work).
DATABASE_URL=

# Neon direct (unpooled) connection string, used by `pnpm db:migrate` and `pnpm db:seed-owner`.
DATABASE_URL_UNPOOLED=

# Neon Auth URL (name confirmed): written by `neon deploy`, path included. Use it as written.
NEON_AUTH_BASE_URL=

# Signs the Neon Auth session cookies. Not provided by Neon: generate it with
# `openssl rand -base64 32` (at least 32 characters). A Wrangler secret.
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage, for product photos. All four are written by `neon deploy`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Local e2e only: turns the API rate limit off so one client can make many requests. Never set it on Cloudflare.
# RATE_LIMIT_OFF=1
