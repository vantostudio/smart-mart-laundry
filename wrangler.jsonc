// Cloudflare Worker config for the site, built by OpenNext (`pnpm cf:build`) into `.open-next/`.
// Based on the template in @opennextjs/cloudflare 1.20.15. No vars or secrets here: secrets go in
// `wrangler secret put` and `.dev.vars`. See docs/decisions/0001-neon-and-neon-auth-on-cloudflare.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "street-mart",
  // Loads the timer shim for Cache Components, then the OpenNext worker (`.open-next/worker.js`).
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-02",
  // nodejs_compat: Next runs on the Node.js runtime. global_fetch_strictly_public: fetch() can't
  // reach the zone's origin or private addresses.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Prerendered pages and _next/static are served from Workers Static Assets.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // The adapter calls its own Worker through this binding; the service must match "name".
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "street-mart",
    },
  ],
  // The live domain. Cloudflare manages its DNS records and certificates.
  "routes": [
    { "pattern": "streetmart.africa", "custom_domain": true },
    { "pattern": "www.streetmart.africa", "custom_domain": true },
  ],
  // OpenNext's shared cache (open-next.config.ts): pages and `use cache` entries in KV, tags in
  // D1. Deploy creates the D1 table and fills KV.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "6269f408a92c453b8ce212d891e17ef3",
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "street-mart-tag-cache",
      "database_id": "6bb50c1c-2e94-47da-a916-7263b61108d1",
    },
  ],
  // console output goes to Workers Logs.
  "observability": {
    "enabled": true,
  },
  "env": {
    // `pnpm cf:deploy --env preview`: its own workers.dev URL. Services and observability aren't
    // inherited, so they are repeated here.
    "preview": {
      "name": "street-mart-preview",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "street-mart-preview",
        },
      ],
      "observability": {
        "enabled": true,
      },
    },
  },
}
