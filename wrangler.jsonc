// Cloudflare Worker config for the site, built by OpenNext (`pnpm cf:build`) into `.open-next/`.
// Based on the template in @opennextjs/cloudflare 1.20.16. No vars or secrets here: secrets go in
// `wrangler secret put` and `.dev.vars`. See docs/decisions/0001-neon-and-neon-auth-on-cloudflare.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "street-mart",
  // Loads the timer shim for Cache Components, then the OpenNext worker (`.open-next/worker.js`).
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-02",
  // nodejs_compat: Next runs on the Node.js runtime. global_fetch_strictly_public: fetch() can't
  // reach the zone's origin or private addresses. no_handle_cross_request_promise_resolution: Next
  // shares in-flight `use cache` fills and revalidations between requests through module-scope
  // promises; with workerd's default, one that outlives its request fails every request waiting on
  // it ("This promise was created by a request that has since ended"), which took every page down
  // on 2026-11-14. Keep it until Next stops sharing them or OpenNext handles it.
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "no_handle_cross_request_promise_resolution",
  ],
  // Prerendered pages and _next/static are served from Workers Static Assets.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // The adapter calls its own Worker through this binding; the service must match "name".
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "street-mart",
    },
  ],
  // The live domain. Cloudflare manages its DNS records and certificates.
  "routes": [
    { "pattern": "streetmart.africa", "custom_domain": true },
    { "pattern": "www.streetmart.africa", "custom_domain": true },
  ],
  // OpenNext's shared cache (open-next.config.ts): pages and `use cache` entries in KV, tags in
  // D1. Deploy creates the D1 table and fills KV.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "6269f408a92c453b8ce212d891e17ef3",
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "street-mart-tag-cache",
      "database_id": "6bb50c1c-2e94-47da-a916-7263b61108d1",
    },
  ],
  // The API's rate limits, one binding per group in src/lib/rate-limit.ts (its `limits` table is
  // the source and its test checks these match). Counted per Cloudflare location. A namespace_id
  // is the counter's account-wide identity: never reuse one for a different limit.
  "ratelimits": [
    { "name": "RATE_LIMIT_READ", "namespace_id": "1001", "simple": { "limit": 180, "period": 60 } },
    {
      "name": "RATE_LIMIT_ADMIN_GATE",
      "namespace_id": "1002",
      "simple": { "limit": 360, "period": 60 },
    },
    {
      "name": "RATE_LIMIT_ADMIN_READ",
      "namespace_id": "1003",
      "simple": { "limit": 180, "period": 60 },
    },
    { "name": "RATE_LIMIT_WRITE", "namespace_id": "1004", "simple": { "limit": 90, "period": 60 } },
    {
      "name": "RATE_LIMIT_UPLOAD",
      "namespace_id": "1005",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // console output goes to Workers Logs.
  "observability": {
    "enabled": true,
  },
  "env": {
    // `pnpm cf:deploy --env preview`: the development environment, on the Neon `dev` branch and its
    // own workers.dev URL. Services, cache bindings, rate limits and observability aren't
    // inherited, so they are repeated here, each with its own resource or counters.
    "preview": {
      "name": "street-mart-preview",
      // `routes` IS inherited: without this empty list a preview deploy takes the live domains.
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "street-mart-preview",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "5f175653528f4f6c9a7daf3b55304738",
        },
      ],
      "d1_databases": [
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "street-mart-preview-tag-cache",
          "database_id": "f16a2068-489e-4c14-8547-18d07e9799a1",
        },
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMIT_READ",
          "namespace_id": "2001",
          "simple": { "limit": 180, "period": 60 },
        },
        {
          "name": "RATE_LIMIT_ADMIN_GATE",
          "namespace_id": "2002",
          "simple": { "limit": 360, "period": 60 },
        },
        {
          "name": "RATE_LIMIT_ADMIN_READ",
          "namespace_id": "2003",
          "simple": { "limit": 180, "period": 60 },
        },
        {
          "name": "RATE_LIMIT_WRITE",
          "namespace_id": "2004",
          "simple": { "limit": 90, "period": 60 },
        },
        {
          "name": "RATE_LIMIT_UPLOAD",
          "namespace_id": "2005",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "observability": {
        "enabled": true,
      },
    },
  },
}
